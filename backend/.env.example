# AIVAR RedForge — Backend Configuration
# Copy this file to .env and adjust values for your environment.

# Application
REDFORGE_APP_NAME=AIVAR RedForge
REDFORGE_APP_VERSION=0.1.0
REDFORGE_DEBUG=true
REDFORGE_ENVIRONMENT=development

# Server
REDFORGE_HOST=0.0.0.0
REDFORGE_PORT=8000

# Database
REDFORGE_DATABASE_URL=postgresql+asyncpg://redforge:redforge@localhost:5432/redforge

# Authentication — REQUIRED in production (app refuses to start with the
# defaults below once REDFORGE_ENVIRONMENT=production). Generate real values,
# e.g.: python -c "import secrets; print(secrets.token_urlsafe(64))"
REDFORGE_JWT_SECRET=CHANGE-ME-IN-PRODUCTION
REDFORGE_MFA_ENCRYPTION_KEY=CHANGE-ME-MFA-ENCRYPTION-KEY-DO-NOT-USE-IN-PRODUCTION=

# Logging
REDFORGE_LOG_LEVEL=DEBUG
REDFORGE_LOG_FORMAT=console

# Credential vault KMS — selects how DEKs are wrapped. Defaults to a local
# AES key-wrap adapter suitable for development only; the app refuses to
# start with the local adapter when REDFORGE_ENVIRONMENT=production unless
# CREDENTIAL_VAULT_ALLOW_LOCAL_KMS_IN_PRODUCTION=true is set explicitly.
# CREDENTIAL_VAULT_KMS_PROVIDER=local
# CREDENTIAL_VAULT_LOCAL_MASTER_KEY=<base64-encoded 32-byte key>
#
# Production: use AWS KMS instead.
# CREDENTIAL_VAULT_KMS_PROVIDER=aws
# CREDENTIAL_VAULT_AWS_KMS_KEY_ARN=arn:aws:kms:us-east-1:123456789012:key/...
# CREDENTIAL_VAULT_AWS_REGION=us-east-1
