# AIVAR RedForge — Root Environment Configuration
# This file documents all environment variables used across services.
# Copy to .env for Docker Compose usage.

# Backend
REDFORGE_APP_NAME=AIVAR RedForge
REDFORGE_APP_VERSION=0.1.0
REDFORGE_DEBUG=true
REDFORGE_ENVIRONMENT=development
REDFORGE_HOST=0.0.0.0
REDFORGE_PORT=8000
REDFORGE_DATABASE_URL=postgresql+asyncpg://redforge:redforge@localhost:5432/redforge
REDFORGE_LOG_LEVEL=DEBUG
REDFORGE_LOG_FORMAT=console

# Authentication — REQUIRED in production; see backend/.env.example for how
# to generate real values.
REDFORGE_JWT_SECRET=CHANGE-ME-IN-PRODUCTION
REDFORGE_MFA_ENCRYPTION_KEY=CHANGE-ME-MFA-ENCRYPTION-KEY-DO-NOT-USE-IN-PRODUCTION=

# Frontend
NEXT_PUBLIC_API_URL=http://localhost:8000

# PostgreSQL
POSTGRES_USER=redforge
POSTGRES_PASSWORD=redforge
POSTGRES_DB=redforge
