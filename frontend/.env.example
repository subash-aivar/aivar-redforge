# AIVAR RedForge — Frontend Configuration
# Copy this file to .env.local and adjust values for your environment.

# Leave NEXT_PUBLIC_API_URL UNSET for normal local development (including
# LAN access, e.g. http://<your-lan-ip>:3000). The frontend talks to the
# backend via a same-origin Next.js rewrite (see next.config.ts), so it
# works on whatever host/port the browser loaded the page from without
# any configuration here.
# NEXT_PUBLIC_API_URL=http://localhost:8000

# Only set this (server-side; never sent to the browser) if the Next.js
# server process cannot reach the backend at http://localhost:8000 —
# e.g. Docker Compose service networking.
# BACKEND_INTERNAL_URL=http://backend:8000
